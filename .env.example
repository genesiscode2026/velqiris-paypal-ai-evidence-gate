# PayPal Developer Sandbox Credentials
PAYPAL_SANDBOX_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_SANDBOX_CLIENT_SECRET=replace-with-sandbox-client-secret

# PostgreSQL Persistence Connection (matches docker-compose.yml default)
DATABASE_URL=postgresql://velqiris_admin:velqiris_secure_pass_2026@127.0.0.1:5432/velqiris_test_db

# Optional Live LLM Inference Proxy (leave blank to run in deterministic offline mode)
OPENAI_API_KEY=
VELQIRIS_MANDATE_SECRET=velqiris_local_mandate_secret_2026

# Local Webhook & Outbox Reconciler Settings
RECONCILER_INTERVAL_MS=2000

